# Relative paths resolve from the project working directory.
DATABASE_PATH=./data/eventroam.sqlite
# Configured canonical origins; request Host must match one of these hosts.
PUBLIC_APEX_ORIGIN=http://localhost:3000
PUBLIC_FESTIVALS_ORIGIN=http://festivals.localhost:3000
# Public browser token and Mapbox style. Leave unset for list-only development.
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12

# Optional PostHog settings. Leave both empty to disable analytics.
# Ingestion export also requires CATALOG_TRACING=true.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Local owner-initiated catalog research. Set credentials only in ignored local env files.
OPENROUTER_API_KEY=
# Optional: retry source HTTP 403 once through Firecrawl.
FIRECRAWL_KEY=
# Optional geocoding for Location and local coordinate checks.
GEOAPIFY_KEY=
# Location uses OPENROUTER_MODEL when this setting is empty.
CATALOG_LOCATION_MODEL=
# Required private workflow history for CLI and Studio; separate from all other files.
CATALOG_WORKFLOW_DATABASE_PATH=./data/mastra-workflows.sqlite
# Optional local agent/model/tool traces; no hosted service. Off by default.
CATALOG_TRACING=false
# Separate from DATABASE_PATH; relative to the project working directory.
CATALOG_OBSERVABILITY_DATABASE_PATH=./data/mastra-observability.duckdb

# Separate worker observations. Never share a DuckDB writer with Studio or CLI.
CATALOG_WORKER_OBSERVABILITY_DATABASE_PATH=./data/mastra-worker-observability.duckdb
# Separate local Mastra datasets, experiment results, and scores.
CATALOG_EVAL_DATABASE_PATH=./data/mastra-evals.sqlite
# Plain Studio conversation history, separate from catalog and observations.
CATALOG_CHAT_DATABASE_PATH=./data/mastra-chat.sqlite
# Selected application events, independent of tracing.
CATALOG_LOGGING=false
# debug, info, warn, error; defaults to info.
CATALOG_LOG_LEVEL=info
# Optional override; defaults to this tool-capable model with structured output.
OPENROUTER_MODEL=openai/gpt-6-luna
# Optional for evals with --model opencode-go/gpt-6-luna.
OPENCODE_GO_KEY=
# Eval, research, and discovery omit the service tier by default.
# Set flex explicitly to use Flex routing.
OPENROUTER_SERVICE_TIER=standard
# Optional: none, minimal, low, medium, high, xhigh; blank defaults to medium.
# Supported levels depend on the chosen model.
OPENROUTER_REASONING_EFFORT=medium
# Optional per-festival safeguards and Mastra agent limits; defaults shown.
CATALOG_MAX_SEARCHES=3
CATALOG_MAX_SEARCH_RESULTS=5
CATALOG_MAX_AGENT_STEPS=15
CATALOG_MAX_DURATION_MS=600000
CATALOG_MAX_PAGE_BYTES=2097152
CATALOG_MAX_MODEL_OUTPUT_TOKENS=16000
