      "checkConstraints": {
        "ingestion_runs_mode_ck": {
          "name": "ingestion_runs_mode_ck",
          "value": "length(trim(\"ingestion_runs\".\"mode\")) > 0"
        },
        "ingestion_runs_status_ck": {
          "name": "ingestion_runs_status_ck",
          "value": "\"ingestion_runs\".\"status\" IN ('running', 'completed', 'failed')"
        },
        "ingestion_runs_input_ck": {
          "name": "ingestion_runs_input_ck",
          "value": "CASE WHEN json_valid(\"ingestion_runs\".\"input_json\") THEN json_type(\"ingestion_runs\".\"input_json\") IS 'object' AND json_extract(\"ingestion_runs\".\"input_json\", '$.mode') IS \"ingestion_runs\".\"mode\" ELSE 0 END"
        },
        "ingestion_runs_report_ck": {
          "name": "ingestion_runs_report_ck",
          "value": "\"ingestion_runs\".\"report_json\" IS NULL OR CASE WHEN json_valid(\"ingestion_runs\".\"report_json\") THEN json_type(\"ingestion_runs\".\"report_json\") IS 'object' AND json_extract(\"ingestion_runs\".\"report_json\", '$.mode') IS \"ingestion_runs\".\"mode\" AND json_extract(\"ingestion_runs\".\"report_json\", '$.runId') IS \"ingestion_runs\".\"id\" AND json_extract(\"ingestion_runs\".\"report_json\", '$.schemaVersion') IS 2 ELSE 0 END"
        },
        "ingestion_runs_lifecycle_ck": {
          "name": "ingestion_runs_lifecycle_ck",
          "value": "(\"ingestion_runs\".\"status\" = 'running' AND \"ingestion_runs\".\"finished_at\" IS NULL AND \"ingestion_runs\".\"report_json\" IS NULL AND \"ingestion_runs\".\"input_tokens\" IS NULL AND \"ingestion_runs\".\"output_tokens\" IS NULL AND \"ingestion_runs\".\"model_cost_usd\" IS NULL AND \"ingestion_runs\".\"search_cost_estimate_usd\" IS NULL AND \"ingestion_runs\".\"duration_ms\" IS NULL AND \"ingestion_runs\".\"usage_complete\" IS NULL) OR (\"ingestion_runs\".\"status\" != 'running' AND \"ingestion_runs\".\"finished_at\" IS NOT NULL AND \"ingestion_runs\".\"report_json\" IS NOT NULL AND \"ingestion_runs\".\"input_tokens\" IS NOT NULL AND \"ingestion_runs\".\"output_tokens\" IS NOT NULL AND \"ingestion_runs\".\"search_cost_estimate_usd\" IS NOT NULL AND \"ingestion_runs\".\"duration_ms\" IS NOT NULL AND \"ingestion_runs\".\"usage_complete\" IS NOT NULL)"
        },
        "ingestion_runs_input_tokens_ck": {
          "name": "ingestion_runs_input_tokens_ck",
          "value": "\"ingestion_runs\".\"input_tokens\" IS NULL OR (typeof(\"ingestion_runs\".\"input_tokens\") = 'integer' AND \"ingestion_runs\".\"input_tokens\" >= 0)"
        },
        "ingestion_runs_output_tokens_ck": {
          "name": "ingestion_runs_output_tokens_ck",
          "value": "\"ingestion_runs\".\"output_tokens\" IS NULL OR (typeof(\"ingestion_runs\".\"output_tokens\") = 'integer' AND \"ingestion_runs\".\"output_tokens\" >= 0)"
        },
        "ingestion_runs_duration_ms_ck": {
          "name": "ingestion_runs_duration_ms_ck",
          "value": "\"ingestion_runs\".\"duration_ms\" IS NULL OR (typeof(\"ingestion_runs\".\"duration_ms\") = 'integer' AND \"ingestion_runs\".\"duration_ms\" >= 0)"
        },
        "ingestion_runs_model_cost_usd_ck": {
          "name": "ingestion_runs_model_cost_usd_ck",
          "value": "\"ingestion_runs\".\"model_cost_usd\" IS NULL OR \"ingestion_runs\".\"model_cost_usd\" >= 0"
        },
        "ingestion_runs_search_cost_estimate_usd_ck": {
          "name": "ingestion_runs_search_cost_estimate_usd_ck",
          "value": "\"ingestion_runs\".\"search_cost_estimate_usd\" IS NULL OR \"ingestion_runs\".\"search_cost_estimate_usd\" >= 0"
