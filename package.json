{
  "name": "eventroam",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": "26.11.1",
    "pnpm": "12.15.0"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "deps:check": "depcruise src commands --output-type err-long",
    "code:repowise": "REPOWISE_OFFLINE=1 REPOWISE_SKIP_EDITOR_SETUP=1 REPOWISE_EMBEDDER=mock uvx --no-config --from repowise==0.62.0 repowise",
    "code:index": "if test -f .repowise/state.json && test -f .repowise/wiki.db; then npm run --silent code:repowise -- update . --no-workspace --index-only --defer-docs --working-tree; else npm run --silent code:repowise -- init . --yes --no-prose --no-editor-setup --no-save-key --no-seed --no-workspace; fi",
    "code:hotspots": "npm run --silent code:index >&2 && npm run --silent code:repowise -- report assessment . --no-workspace --sections hotspots",
    "code:health": "npm run --silent code:index >&2 && npm run --silent code:repowise -- health . --no-workspace",
    "docs:architecture": "env -u OPENAI_API_KEY -u OPENROUTER_API_KEY -u ANTHROPIC_API_KEY -u GEMINI_API_KEY -u OLLAMA_HOST -u MINIMAX_API_KEY likec4 start docs/architecture --listen 127.0.0.1 --no-use-dot",
    "docs:architecture:build": "likec4 build docs/architecture --output dist/architecture --output-single-file --no-build-webcomponent --use-hash-history --base ./ --no-use-dot",
    "docs:check": "node scripts/check-docs.mjs && node --test scripts/check-docs.test.mjs",
    "openspec:validate": "node scripts/openspec.mjs validate",
    "openspec:archive": "node scripts/openspec.mjs archive",
    "test:openspec": "node --test scripts/openspec.test.mjs",
    "format:check": "prettier --check src commands e2e scripts drizzle.config.ts next.config.ts playwright.config.ts vitest.config.mts postcss.config.mjs eslint.config.mjs .dependency-cruiser.mjs package.json tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:site": "tsx src/test/site-smoke.ts",
    "db:migrate": "tsx commands/catalog-db.ts migrate",
    "db:fixtures": "tsx commands/catalog-db.ts fixtures",
    "catalog": "tsx commands/catalog.ts",
    "catalog:eval": "tsx --env-file-if-exists=.env commands/catalog-eval.ts",
    "catalog:studio": "tsx --env-file-if-exists=.env commands/catalog-studio.ts",
    "test:coverage": "vitest run --coverage",
    "studio:build": "mastra build --studio && node scripts/build-studio-commands.mjs",
    "studio:start": "node .mastra/output/commands/studio-start.mjs",
    "docker:smoke": "node scripts/compose-smoke.mjs",
    "db:pull": "node --env-file-if-exists=.env scripts/db-transfer.mjs pull",
    "db:push": "node --env-file-if-exists=.env scripts/db-transfer.mjs push",
    "test:db-transfer": "node --test scripts/db-transfer.test.mjs",
    "test:backup": "node --test scripts/backup.test.mjs"
  },
  "dependencies": {
    "@mastra/core": "1.79.0",
    "@mastra/deployer": "1.79.0",
    "@mastra/duckdb": "1.15.0",
    "@mastra/libsql": "1.27.0",
    "@mastra/loggers": "1.3.9",
    "@mastra/memory": "1.39.0",
    "@mastra/observability": "1.21.0",
    "@mastra/posthog": "1.4.3",
    "@mdream/js": "2.0.3",
    "@tailwindcss/postcss": "4.3.3",
    "better-sqlite3": "13.0.3",
    "cheerio": "1.2.0",
    "drizzle-orm": "0.45.4",
    "got": "16.1.0",
    "hono": "4.13.12",
    "mapbox-gl": "3.33.0",
    "mdast-util-from-markdown": "2.1.0",
    "next": "16.4.3",
    "posthog-js": "1.440.0",
    "posthog-node": "5.57.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-sonarjs": "4.2.2",
    "jsdom": "30.1.3",
    "likec4": "1.61.0",
    "mastra": "1.35.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
