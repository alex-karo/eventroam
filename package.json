{
  "name": "eventroam",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.10.0",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "docs:check": "node scripts/check-docs.mjs && node --test scripts/check-docs.test.mjs",
    "openspec:validate": "openspec validate --all --strict",
    "format:check": "prettier --check src commands e2e scripts drizzle.config.ts next.config.ts playwright.config.ts vitest.config.mts postcss.config.mjs eslint.config.mjs package.json tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "db:migrate": "tsx commands/catalog-db.ts migrate",
    "db:fixtures": "tsx commands/catalog-db.ts fixtures",
    "catalog": "tsx --env-file-if-exists=.env commands/catalog.ts",
    "catalog:eval": "tsx --env-file-if-exists=.env commands/catalog-eval.ts"
  },
  "dependencies": {
    "@mastra/core": "1.74.0",
    "@tailwindcss/postcss": "4.3.3",
    "better-sqlite3": "13.0.3",
    "cheerio": "1.2.0",
    "drizzle-orm": "0.45.3",
    "got": "16.0.0",
    "mapbox-gl": "3.30.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.14.0",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/turndown": "5.0.6",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-sonarjs": "4.2.2",
    "mdast-util-from-markdown": "2.1.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
